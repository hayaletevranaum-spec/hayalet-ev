{
  "schemaVersion": 2,
  "id": "game-room",
  "name": "Game Room",
  "version": "2.5.0",
  "menu": {
    "label": "Game Room",
    "icon": "🎮",
    "iconSrc": "shared/assets/nav-icon.svg",
    "order": 80
  },
  "runtime": {
    "uiEntry": "ui/index.html",
    "hostEntry": "host/index.js"
  },
  "defaultFeatureId": "backgammon",
  "features": [
    {
      "id": "backgammon",
      "name": "Tavla",
      "description": "Classic Tavla matches against AI1, AI2, or the connected US1 remote user.",
      "icon": "TV",
      "commandSpecs": [
        {
          "name": "GameRoomBackgammonStart",
          "description": "Start a new Tavla match from the room UI.",
          "scope": "room-ui",
          "exposure": "internal"
        },
        {
          "name": "GameRoomBackgammonReset",
          "description": "Reset the active Tavla match state.",
          "scope": "room-ui",
          "exposure": "internal"
        },
        {
          "name": "GameRoomBackgammonUserMove",
          "description": "Apply the user's Tavla legal move from the room UI.",
          "scope": "room-ui",
          "exposure": "internal"
        },
        {
          "name": "GameRoomBackgammonAiMove",
          "description": "Apply the AI Tavla move returned by the selected opponent slot.",
          "scope": "ai-slots",
          "exposure": "internal"
        },
        {
          "name": "GameRoomBackgammonRemoteMove",
          "description": "Apply the remote US1 Tavla move delivered over room mail transport.",
          "scope": "us1",
          "exposure": "internal"
        },
        {
          "name": "GameRoomBackgammonAcceptInvite",
          "description": "Accept an incoming US1 Tavla invite from the room UI.",
          "scope": "room-ui",
          "exposure": "internal"
        },
        {
          "name": "GameRoomBackgammonRejectInvite",
          "description": "Reject an incoming US1 Tavla invite from the room UI.",
          "scope": "room-ui",
          "exposure": "internal"
        }
      ],
      "protocolSpecs": [
        {
          "key": "game-room-backgammon-user-start",
          "room": "game-room",
          "scenario": "backgammon-user-start",
          "title": "[START][GAME-ROOM][TAVLA][USER-FIRST]",
          "editable": true,
          "path": "main-functions/backgammon/protocols/game-room-backgammon-user-start.md"
        },
        {
          "key": "game-room-backgammon-ai-start",
          "room": "game-room",
          "scenario": "backgammon-ai-start",
          "title": "[START][GAME-ROOM][TAVLA][AI-FIRST]",
          "editable": true,
          "path": "main-functions/backgammon/protocols/game-room-backgammon-ai-start.md"
        },
        {
          "key": "game-room-backgammon-us1-transport",
          "room": "game-room",
          "scenario": "backgammon-us1-transport",
          "title": "[INFO][GAME-ROOM][TAVLA][US1-TRANSPORT]",
          "editable": false,
          "path": "main-functions/backgammon/protocols/game-room-backgammon-us1-transport.md"
        }
      ],
      "scene": {
        "hotspot": {
          "id": "game-room-backgammon",
          "rect": {
            "leftPx": 188,
            "topPx": 362,
            "widthPx": 446,
            "heightPx": 258
          },
          "label": {
            "text": "Tavla"
          }
        },
        "view": {
          "id": "backgammon-closeup",
          "backgroundSrc": "main-functions/backgammon/assets/backgammon-view.webp",
          "transparentWindow": {
            "leftPct": 28.28,
            "topPct": 18.8,
            "widthPct": 43.59,
            "heightPct": 54.17
          }
        }
      }
    },
    {
      "id": "team-tetris",
      "name": "Team Tetris",
      "description": "A four-seat, turn-based team Tetris mode for the local user, AI1, AI2, and the connected US1 remote user.",
      "icon": "TT",
      "commandSpecs": [
        {
          "name": "GameRoomTeamTetrisStart",
          "description": "Start a new Team Tetris match from the room UI.",
          "scope": "room-ui",
          "exposure": "internal"
        },
        {
          "name": "GameRoomTeamTetrisReset",
          "description": "Reset the active Team Tetris match state.",
          "scope": "room-ui",
          "exposure": "internal"
        },
        {
          "name": "GameRoomTeamTetrisUserMove",
          "description": "Apply the local user's Team Tetris path selection from the room UI.",
          "scope": "room-ui",
          "exposure": "internal"
        },
        {
          "name": "GameRoomTeamTetrisAiMove",
          "description": "Apply the Team Tetris move returned by AI1 or AI2.",
          "scope": "ai-slots",
          "exposure": "internal"
        },
        {
          "name": "GameRoomTeamTetrisRemoteMove",
          "description": "Apply the Team Tetris move delivered over the connected US1 transport.",
          "scope": "us1",
          "exposure": "internal"
        }
      ],
      "protocolSpecs": [
        {
          "key": "game-room-team-tetris-ai-opening",
