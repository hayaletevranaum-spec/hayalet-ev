        },
        {
          "key": "game-room-team-tetris-us1-transport",
          "room": "game-room",
          "scenario": "team-tetris-us1-transport",
          "title": "[INFO][GAME-ROOM][TEAM-TETRIS][US1-TRANSPORT]",
          "editable": false,
          "path": "main-functions/team-tetris/protocols/game-room-team-tetris-us1-transport.md"
        }
