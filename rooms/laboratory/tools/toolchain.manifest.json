        "process": "optional",
        "report": "optional"
      },
      "probe": {
        "args": ["-ver"],
        "versionRegex": "(\\d+(?:\\.\\d+)+|\\d+)"
      },
      "releaseProvider": {
        "type": "web-page",
        "latestPageUrl": "https://exiftool.org/",
        "releaseUrl": "https://exiftool.org/",
        "versionRegex": "Image-ExifTool-([0-9.]+)\\.tar\\.gz"
      },
      "assets": {
        "linux-x64": {
          "assetMatch": "Image-ExifTool-${version}.tar.gz",
          "archive": "tar.gz",
          "downloadUrlTemplate": "https://sourceforge.net/projects/exiftool/files/Image-ExifTool-${version}.tar.gz/download",
          "executableName": "exiftool",
          "copyArchiveContents": true
