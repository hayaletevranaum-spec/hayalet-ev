{
  "version": 1,
  "roomId": "laboratory",
  "tools": {
    "yt-dlp": {
      "displayName": "yt-dlp",
      "installDirName": "yt-dlp",
      "installStrategy": "automatic",
      "usedBy": ["Media intake", "YouTube capture"],
      "testImpact": ["source-routing", "youtube-import"],
      "readinessImpact": "Blocks remote YouTube video intake flows.",
      "stageSupport": {
        "source": "required",
        "edit": "unsupported",
        "profile": "unsupported",
        "process": "unsupported",
        "report": "unsupported"
      },
      "releaseProvider": {
        "type": "github-release",
        "owner": "yt-dlp",
        "repo": "yt-dlp",
        "releaseUrl": "https://github.com/yt-dlp/yt-dlp/releases/latest"
      },
      "probe": {
        "args": ["--version"],
        "versionRegex": "(\\d{4}\\.\\d{2}\\.\\d{2}(?:\\.[0-9]+)?)"
      },
      "assets": {
        "linux-x64": {
          "assetMatch": "^yt-dlp_linux$",
          "archive": "none",
          "executableName": "yt-dlp"
        },
        "linux-arm64": {
          "assetMatch": "^yt-dlp_linux_aarch64$",
          "archive": "none",
          "executableName": "yt-dlp"
        },
        "linux-musl-x64": {
          "assetMatch": "^yt-dlp_musllinux$",
          "archive": "none",
          "executableName": "yt-dlp"
        },
        "darwin-x64": {
          "assetMatch": "^yt-dlp_macos$",
          "archive": "none",
          "executableName": "yt-dlp"
        },
        "darwin-arm64": {
          "assetMatch": "^yt-dlp_macos$",
          "archive": "none",
          "executableName": "yt-dlp"
        },
        "win32-x64": {
          "assetMatch": "^yt-dlp\\.exe$",
          "archive": "none",
          "executableName": "yt-dlp.exe"
        },
        "win32-arm64": {
          "assetMatch": "^yt-dlp_arm64\\.exe$",
          "archive": "none",
          "executableName": "yt-dlp.exe"
        }
      }
    },
    "ffmpeg": {
      "displayName": "FFmpeg",
      "installDirName": "ffmpeg",
      "availability": "system-command",
      "installStrategy": "automatic",
      "usedBy": ["Media edit", "Profile artifacts", "Managed process runs"],
      "testImpact": ["media-edit", "profile-preflight", "managed-reporting"],
      "readinessImpact": "Blocks local transforms, derived outputs, and most managed analysis runs.",
      "stageSupport": {
        "source": "required",
        "edit": "required",
        "profile": "required",
        "process": "required",
        "report": "unsupported"
      },
      "releaseProvider": {
        "type": "github-release",
        "owner": "yt-dlp",
        "repo": "FFmpeg-Builds",
        "releaseUrl": "https://github.com/yt-dlp/FFmpeg-Builds/releases/latest"
      },
      "probe": {
        "args": ["-version"],
        "versionRegex": "ffmpeg version\\s+([^\\s]+)"
      },
      "systemCommand": {
        "executableName": "ffmpeg",
        "companionExecutables": ["ffprobe", "ffprobe.exe"],
        "envVarNames": ["HAYALET_FFMPEG_PATH", "FFMPEG_PATH"],
        "candidatePaths": [
          "${dataDir}/host-dependencies/ffmpeg/win32-x64/ffmpeg.exe",
          "${dataDir}/host-dependencies/ffmpeg/win32-arm64/ffmpeg.exe",
          "${dataDir}/host-dependencies/ffmpeg/linux-x64/ffmpeg",
          "${dataDir}/host-dependencies/ffmpeg/linux-arm64/ffmpeg"
        ],
        "setupHint": "Prepare the shared FFmpeg runtime from Settings > Capture, or expose ffmpeg on PATH and refresh Laboratory tools."
      },
      "assets": {
        "linux-x64": {
          "assetMatch": "^ffmpeg-master-latest-linux64-gpl\\.tar\\.xz$",
          "archive": "tar.xz",
          "executableName": "ffmpeg",
          "companionExecutables": ["ffprobe"]
        },
        "linux-arm64": {
          "assetMatch": "^ffmpeg-master-latest-linuxarm64-gpl\\.tar\\.xz$",
          "archive": "tar.xz",
          "executableName": "ffmpeg",
          "companionExecutables": ["ffprobe"]
        },
        "win32-x64": {
          "assetMatch": "^ffmpeg-master-latest-win64-gpl\\.zip$",
          "archive": "zip",
          "executableName": "ffmpeg.exe",
          "companionExecutables": ["ffprobe.exe"]
        },
        "win32-arm64": {
          "assetMatch": "^ffmpeg-master-latest-winarm64-gpl\\.zip$",
          "archive": "zip",
          "executableName": "ffmpeg.exe",
          "companionExecutables": ["ffprobe.exe"]
        }
      }
    },
    "visual-forensics-py": {
      "displayName": "Visual Forensics Python",
      "installDirName": "visual-forensics-py",
      "availability": "system-command",
      "installStrategy": "automatic",
      "usedBy": ["Near-duplicate frame checks", "Optical-flow assist", "Reference quality checks"],
      "testImpact": ["visual-forensics", "reference-quality", "duplicate-frame-analysis"],
      "readinessImpact": "Optional OpenCV/scikit-image helpers remain unavailable; FFmpeg proxy probes still run where possible.",
      "stageSupport": {
        "source": "unsupported",
        "edit": "unsupported",
        "profile": "optional",
        "process": "optional",
        "report": "optional"
      },
      "probe": {
        "args": ["-c", "import cv2, skimage, numpy, scipy; print(cv2.__version__)"],
        "versionRegex": "(\\d+(?:\\.\\d+)+)"
      },
      "systemCommand": {
        "executableName": "python3",
        "candidatePaths": [
          "${roomStorageDir}/runtime/visual-forensics-py-venv/bin/python3",
          "${roomStorageDir}/runtime/visual-forensics-py-venv/bin/python",
          "${roomStorageDir}/runtime/visual-forensics-py-venv/Scripts/python.exe"
        ],
        "setupHint": "Use the in-app install to prepare OpenCV, scikit-image, numpy, and scipy in a Laboratory-managed Python runtime, then refresh this tool from settings."
      },
      "installer": {
        "type": "python-venv-pip",
        "venvDir": "${roomStorageDir}/runtime/visual-forensics-py-venv",
        "estimatedDownloadSize": "180 - 600 MB",
        "estimatedInstalledSize": "500 MB - 1.5 GB",
        "supportedPythonVersions": ["3.12", "3.11", "3.10"],
        "packages": ["opencv-contrib-python-headless", "scikit-image", "numpy", "scipy"]
      }
    },
    "exiftool": {
      "displayName": "ExifTool",
      "installDirName": "exiftool",
      "availability": "installable",
      "installStrategy": "automatic",
      "usedBy": ["Metadata provenance audit", "Capture metadata cross-check"],
      "testImpact": ["metadata-provenance", "report-counter-evidence"],
