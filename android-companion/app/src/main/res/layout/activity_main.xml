<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1115"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#F5F7FA"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subtitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/companion_subtitle"
            android:textColor="#B8C0CC"
            android:textSize="14sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/statusPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="#161B24"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="visible">

            <TextView
                android:id="@+id/statusLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_label"
                android:textColor="#8FA0B5"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/statusValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#F5F7FA"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/targetLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/target_label"
                android:textColor="#8FA0B5"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/targetValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#F5F7FA"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/permissionsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/permissions_label"
                android:textColor="#8FA0B5"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/permissionsValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#F5F7FA"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/operationsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/operations_label"
                android:textColor="#8FA0B5"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/operationsValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/operations_status_idle"
                android:textColor="#F5F7FA"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/torchLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/torch_label"
                android:textColor="#8FA0B5"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/torchValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/torch_status_off"
                android:textColor="#F5F7FA"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/companionTabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="#161B24"
            app:tabIndicatorColor="#70D8FF"
            app:tabMode="fixed"
            app:tabRippleColor="#26364A"
            app:tabSelectedTextColor="#F5F7FA"
            app:tabTextColor="#8FA0B5">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_image" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_dictate" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_ambient" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_tts" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_logs" />
        </com.google.android.material.tabs.TabLayout>

        <LinearLayout
            android:id="@+id/imageTabPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:background="#1A1F29">

                <androidx.camera.view.PreviewView
                    android:id="@+id/cameraPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#1A1F29" />

                <LinearLayout
                    android:id="@+id/previewPlaceholder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/preview_waiting_title"
                        android:textColor="#F5F7FA"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:text="@string/preview_waiting_body"
                        android:textColor="#B8C0CC"
                        android:textSize="14sp" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:id="@+id/imageStatusPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="#161B24"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/previewLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/preview_label"
                    android:textColor="#8FA0B5"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/previewValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#F5F7FA"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/imageCaptureActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/imageCaptureClearButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/image_capture_clear" />

                <Button
                    android:id="@+id/imageCaptureButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/image_capture_take" />

                <Button
                    android:id="@+id/imageCaptureAddButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/image_capture_add" />
            </LinearLayout>

            <TextView
                android:id="@+id/imageCaptureFeedbackValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/image_capture_feedback_waiting"
                android:textColor="#B8C0CC"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dictateTabPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#161B24"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/dictationTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/dictation_title"
                android:textColor="#F5F7FA"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dictationSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/dictation_subtitle"
                android:textColor="#B8C0CC"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/dictationStatusLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/dictation_status_label"
                android:textColor="#8FA0B5"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/dictationStatusValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#F5F7FA"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dictationDetailLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/dictation_detail_label"
                android:textColor="#8FA0B5"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/dictationDetailValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#F5F7FA"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/dictationModelLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/dictation_model_label"
                android:textColor="#8FA0B5"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/dictationModelValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#F5F7FA"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/dictationTargetLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/target_label"
                android:textColor="#8FA0B5"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/dictationTargetValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#F5F7FA"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/manualDictationTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/manual_dictation_title"
                android:textColor="#F5F7FA"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/manualDictationBackendLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/manual_dictation_backend_label"
                android:textColor="#8FA0B5"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/manualDictationBackendValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="#222A36"
                android:padding="12dp"
                android:text="@string/manual_dictation_backend_vosk"
                android:textColor="#F5F7FA"
                android:textSize="15sp" />

            <Button
                android:id="@+id/manualDictationToggleButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/manual_dictation_start" />

            <TextView
                android:id="@+id/manualDictationTranscriptLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/manual_dictation_transcript_label"
                android:textColor="#8FA0B5"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/manualDictationTranscriptValue"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="6dp"
                android:background="#10141C"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:minLines="4"
                android:padding="12dp"
                android:text="@string/manual_dictation_transcript_empty"
                android:textColor="#F5F7FA"
                android:textColorHint="#8FA0B5"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ambientTabPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#161B24"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/ambientTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ambient_title"
                android:textColor="#F5F7FA"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ambientSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/ambient_subtitle"
                android:textColor="#B8C0CC"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/ambientMicrophoneLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/ambient_microphone_label"
                android:textColor="#8FA0B5"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/ambientMicrophoneValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#F5F7FA"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ambientStatusLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/ambient_status_label"
                android:textColor="#8FA0B5"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/ambientStatusValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#F5F7FA"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ambientDetailLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/ambient_detail_label"
                android:textColor="#8FA0B5"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/ambientDetailValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#F5F7FA"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/ambientWakePhraseLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/ambient_wake_phrase_label"
                android:textColor="#8FA0B5"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/ambientWakePhraseValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#F5F7FA"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/ambientHistoryLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/ambient_history_label"
                android:textColor="#8FA0B5"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/ambientHistoryValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="#10141C"
                android:fontFamily="monospace"
                android:minHeight="140dp"
                android:padding="12dp"
                android:text="@string/ambient_history_empty"
                android:textColor="#F5F7FA"
                android:textIsSelectable="true"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ttsTabPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#161B24"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/ttsTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tts_title"
                android:textColor="#F5F7FA"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ttsSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/tts_subtitle"
                android:textColor="#B8C0CC"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/ttsStatusLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/tts_status_label"
                android:textColor="#8FA0B5"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/ttsStatusValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#F5F7FA"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ttsDetailLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/tts_detail_label"
                android:textColor="#8FA0B5"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/ttsDetailValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#F5F7FA"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/ttsModelLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/tts_model_label"
                android:textColor="#8FA0B5"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/ttsModelValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#F5F7FA"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/ttsTextLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/tts_text_label"
                android:textColor="#8FA0B5"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/ttsTextValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="#10141C"
                android:minHeight="120dp"
                android:padding="12dp"
                android:text="@string/tts_text_empty"
                android:textColor="#F5F7FA"
                android:textIsSelectable="true"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/logsTabPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/diagnosticsPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#161B24"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/diagnosticsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/diagnostics_label"
                    android:textColor="#8FA0B5"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/diagnosticsSummaryValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="monospace"
                    android:textColor="#F5F7FA"
                    android:textIsSelectable="true"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/diagnosticsCopyButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/diagnostics_copy" />

                    <Button
                        android:id="@+id/diagnosticsShareButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="@string/diagnostics_share" />

                    <Button
                        android:id="@+id/diagnosticsClearButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="@string/diagnostics_clear" />
                </LinearLayout>

                <TextView
                    android:id="@+id/diagnosticsLogsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/diagnostics_logs_label"
                    android:textColor="#8FA0B5"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/diagnosticsLogsValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="monospace"
                    android:textColor="#F5F7FA"
                    android:textIsSelectable="true"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
